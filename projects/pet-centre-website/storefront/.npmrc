# Hydrogen's Vite config lists transitive deps (cookie, set-cookie-parser
# from react-router) in ssr.optimizeDeps.include as bare specifiers, which
# Vite resolves from the project root. pnpm's default isolated layout keeps
# those out of the root node_modules, causing "Failed to resolve dependency"
# at dev start. Hoisting to the root mirrors npm's flat layout and resolves it
# while keeping pnpm's global store (disk + speed) benefits.
shamefully-hoist=true
