# job-hunt — daily Malta digest credentials
# Copy to .env and fill in. Trigger.dev dashboard keys mirror these.

# ─── Reused from meetsync (same Trigger.dev project) ─────────────
# Already in meetsync/.env and in the Trigger.dev dashboard for
# proj_njxprjwjwpnxifasacvr. Copy the values into job-hunt/.env so the local
# tools (init-sheet, mint-token, reset-dedup) can also use them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Job-hunt specific — MUST be minted/set by you ────────────────
# Refresh token with scopes: gmail.send + spreadsheets.
# Run `node --env-file=.env tools/mint-token.mjs` after filling in the two
# GOOGLE_CLIENT_* values above — it opens a browser and prints the token.
JOBHUNT_GOOGLE_REFRESH_TOKEN=

# Firecrawl (https://firecrawl.dev) — scraping
FIRECRAWL_API_KEY=

# Google Sheet ID — auto-filled after running `node tools/init-sheet.mjs`
GOOGLE_SHEET_ID=

# Digest recipient
GMAIL_RECIPIENT=

# Optional — LinkedIn session cookie (li_at) for authenticated scraping.
# Public scraping works without it.
LINKEDIN_SESSION_COOKIE=

# Pipeline toggles
JOBHUNT_DRY_RUN=false          # true → skip sheet writes + email
JOBHUNT_DIGEST_CAP=20          # max jobs per email
