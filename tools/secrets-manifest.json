{
  "$schema": "./secrets-manifest.schema.json",
  "vault": "AI-Stack",
  "comment": "Source of truth for which secrets exist and where they need to land. Fill in the opRef for each item after creating the AI-Stack vault in 1Password. Only items with non-empty opRef are synced; the rest are skipped (use this to stage a partial migration).",
  "platforms": [
    {
      "id": "cloudflare-meetsync",
      "type": "wrangler",
      "cwd": "meetsync/worker",
      "comment": "Pushed via `wrangler secret put` — invokes the wrangler CLI in the meetsync/worker directory."
    },
    {
      "id": "trigger-prod",
      "type": "trigger-env-file",
      "outputPath": ".tmp/trigger-prod.env",
      "comment": "Writes a 0600 .env to .tmp/. Upload via Trigger.dev dashboard → Project → Environment Variables → Import .env. Done once per rotation."
    }
  ],
  "secrets": [
    { "name": "TELEGRAM_BOT_TOKEN",        "opRef": "op://AI-Stack/meetsync-bot/token",            "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "TELEGRAM_WEBHOOK_SECRET",   "opRef": "op://AI-Stack/meetsync-webhook/secret",       "platforms": ["cloudflare-meetsync"] },
    { "name": "ADMIN_CHAT_ID",             "opRef": "op://AI-Stack/meetsync-admin/chat-id",        "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "DASHBOARD_TOKEN",           "opRef": "op://AI-Stack/meetsync-dashboard/token",      "platforms": ["cloudflare-meetsync"] },
    { "name": "INTERNAL_ALERT_SECRET",     "opRef": "op://AI-Stack/internal-alert/secret",         "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "ANTHROPIC_API_KEY",         "opRef": "op://AI-Stack/anthropic/api-key",             "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "ANTHROPIC_ADMIN_API_KEY",   "opRef": "op://AI-Stack/anthropic-admin/api-key",       "platforms": ["trigger-prod"] },
    { "name": "TRIGGERDEV_API_KEY",        "opRef": "op://AI-Stack/triggerdev/api-key",            "platforms": ["cloudflare-meetsync"] },
    { "name": "TRIGGERDEV_API_URL",        "opRef": "op://AI-Stack/triggerdev/api-url",            "platforms": ["cloudflare-meetsync"] },
    { "name": "GOOGLE_CLIENT_ID",          "opRef": "op://AI-Stack/google-meetsync-oauth/client-id", "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "GOOGLE_CLIENT_SECRET",      "opRef": "op://AI-Stack/google-meetsync-oauth/client-secret", "platforms": ["cloudflare-meetsync", "trigger-prod"] },
    { "name": "OAuth_Client_ID_Desktop",   "opRef": "op://AI-Stack/google-jobhunt-oauth/client-id", "platforms": ["trigger-prod"] },
    { "name": "OAuth_Client_Secret_Desktop","opRef": "op://AI-Stack/google-jobhunt-oauth/client-secret", "platforms": ["trigger-prod"] },
    { "name": "Google_Refresh_Token",      "opRef": "op://AI-Stack/google-jobhunt-oauth/refresh-token", "platforms": ["trigger-prod"] },
    { "name": "Gmail_Recepient",           "opRef": "op://AI-Stack/jobhunt-recipient/email",       "platforms": ["trigger-prod"] },
    { "name": "CLOUDFLARE_ACCOUNT_ID",     "opRef": "op://AI-Stack/cloudflare/account-id",         "platforms": ["trigger-prod"] },
    { "name": "CLOUDFLARE_API_TOKEN",      "opRef": "op://AI-Stack/cloudflare/api-token",          "platforms": ["trigger-prod"] },
    { "name": "CLOUDFLARE_BILLING_API_TOKEN","opRef": "op://AI-Stack/cloudflare/billing-api-token", "platforms": ["trigger-prod"] },
    { "name": "CLOUDFLARE_D1_DATABASE_ID", "opRef": "op://AI-Stack/cloudflare/d1-meetsync-id",     "platforms": ["trigger-prod"] },
    { "name": "ELEVENLABS_API_KEY",        "opRef": "op://AI-Stack/elevenlabs/api-key",            "platforms": ["trigger-prod"] },
    { "name": "FIRECRAWL_API_KEY",         "opRef": "op://AI-Stack/firecrawl/api-key",             "platforms": ["trigger-prod"] },
    { "name": "BILLING_SHEET_ID",          "opRef": "op://AI-Stack/billing-sheet/password",        "platforms": ["trigger-prod"] }
  ]
}
