# MeetSync test environment — for synthetic webhook testing (no real Telegram account).
# Copy this file to `.env.test` and fill in the real values.
# `.env.test` is gitignored via the root `.env.*` rule.

# Cloudflare Worker URL (no trailing slash). Find it via:
#   cd worker && npx wrangler deployments list
#   or in Cloudflare dashboard → Workers → meetsync-worker → Settings → Triggers
WORKER_URL=https://meetsync-worker.<subdomain>.workers.dev

# Webhook secret — must match what was set via `wrangler secret put TELEGRAM_WEBHOOK_SECRET`
# and what Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
# List/rotate with: `cd worker && npx wrangler secret list` / `wrangler secret put`
TELEGRAM_WEBHOOK_SECRET=

# Reserved fake chat_ids for tests — match the TEST_CHAT_IDS set in
# Engineering/trigger-automations/src/trigger/meetsync/telegram-client.ts
# Replies to these ids are intercepted and logged instead of sent via Bot API.
TEST_CHAT_ID_A=999999001
TEST_CHAT_ID_B=999999002

# Claude Haiku key for the Haiku-as-judge assertion helper in
# tools/test-scenarios/_judge.sh. Same value as ANTHROPIC_API_KEY in the
# Trigger.dev dashboard — grab it from there and paste here. One full suite
# run costs ~$0.02 in Haiku tokens.
ANTHROPIC_API_KEY=
